# Auto-door: ESP32-C6, Matter over Wi-Fi, BLE commissioning.
# Based on esp-matter release/v1.5 examples/light/sdkconfig.defaults.

CONFIG_IDF_TARGET="esp32c6"
# 4 MB is the safe common denominator; modules with 8 MB work too.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# BLE (NimBLE) for commissioning only, memory released afterwards
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y

# Matter over Wi-Fi station, no Thread, no soft-AP
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_OPENTHREAD_ENABLED=n

# lwIP
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
# unique local addresses for fabrics (MAX_FABRIC) + link local
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Matter shell: `matter esp cover help`
CONFIG_ENABLE_CHIP_SHELL=y
# Console: UART0 (DevKitC-1 "UART" connector) = logs + shell input, survives chip resets.
# The "USB" connector (USB-Serial/JTAG) only mirrors the logs; it cannot be typed into.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# OTA requestor (needs a Matter OTA provider in production)
CONFIG_ENABLE_OTA_REQUESTOR=y

CONFIG_MBEDTLS_HKDF_C=y

# Development defaults: test DAC / test discriminator & passcode.
# See README "Commissioning data: development vs production".

# Exclude unused clusters to optimise flash and RAM (Window Covering stays enabled)
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
